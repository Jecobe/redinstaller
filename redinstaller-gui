SETTING = {s[0]: s for s in SETTINGS}


def cfg_defaults():
    return {k: d for k, _, d, _, _ in SETTINGS}


def cfg_norm(key, v):
    """Normalised value, or None if invalid."""
    t = SETTING[key][1]
    if t == "bool":
        return {"true": "true", "yes": "true", "on": "true", "1": "true",
                "false": "false", "no": "false", "off": "false", "0": "false"}.get(v.lower())
    if t == "int":
        return str(int(v)) if re.fullmatch(r"[0-9]+", v) and int(v) <= 10 else None
    if t == "text":
        return v if "\n" not in v else None
    return v.lower() if v.lower() in t.split("/") else None


def cfg_load(cfg):
    """Read the config file into cfg; returns a list of warnings."""
    warnings = []
    try:
        with open(CONFIG_FILE, encoding="utf-8", errors="replace") as fh:
            lines = fh.read().split("\n")
    except OSError:
        return warnings
    for n, line in enumerate(lines, 1):
        if re.match(r"^\s*(#|$)", line):
            continue
        k, _, v = line.partition("=")
        k = re.sub(r"\s", "", k)
        v = v.strip()
        if "=" not in line or k not in SETTING:
            warnings.append(f"Config line {n} ignored (unknown setting): {line}")
        elif (nv := cfg_norm(k, v)) is None:
            warnings.append(f"Config: invalid value for {k} on line {n}; using {cfg.get(k) or 'empty'}")
        else:
            cfg[k] = nv
    return warnings


def cfg_save(cfg):
    out = ["# Redinstaller settings. Change them with: redinstaller --config",
           "# (or edit this file). Command-line options override them for one run."]
    for k, t, d, label, desc in SETTINGS:
        t = {"bool": "true or false", "int": "a number 0-10", "text": "text"}.get(t, t.replace("/", " | "))
        out += ["", f"# {label}: {desc}", f"# {t}; default: {d or 'empty'}", f"{k} = {cfg[k]}"]
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    tmp = f"{CONFIG_FILE}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")
    os.replace(tmp, CONFIG_FILE)


class Options:
    """Settings for this run: the config, then the command line on top."""

    def __init__(self, cfg, args):
        is_ = lambda k, v: cfg[k] == v
        self.silent = is_("silent", "true")
        self.recursive = is_("recursive", "true")
        self.auto_pick = is_("auto_pick_folder", "true")
        self.max_up = int(cfg["search_levels_up"])
        self.confirm = is_("confirm_install", "true")
        self.launch = {"always": True, "never": False}.get(cfg["launch_options"])  # None = ask
        self.launch_value = cfg["launch_options_value"] or DEFAULT_LAUNCH
        self.launch_mode = cfg["launch_options_mode"]
        self.close_steam = cfg["close_steam"]
        self.force = cfg["protontricks"] if cfg["protontricks"] in ("native", "flatpak") else None
        self.verbose = is_("verbose", "true")
        self.show_banner = is_("show_banner", "true")
        self.steam_dir = os.environ.get("STEAM_DIR") or ""
        if not self.steam_dir and cfg["steam_dir"]:
            self.steam_dir = cfg["steam_dir"]
            if self.steam_dir.startswith("~"):
                self.steam_dir = HOME + self.steam_dir[1:]
        self.dry_run = False
        for name, value in args.overrides:
            setattr(self, name, value)


# ── distro-specific install hints ────────────────────────────────────────────
def distro():
    """arch | debian | ubuntu | fedora | immutable (SteamOS, Bazzite…) | ''"""
    info = {}
    try:
        with open("/etc/os-release") as fh:
            for line in fh:
                k, _, v = line.strip().partition("=")
                if k in ("ID", "ID_LIKE"):
                    info[k] = v.strip("\"'")
    except OSError:
        pass
    if info.get("ID") == "steamos" or os.path.exists("/run/ostree-booted"):
        return "immutable"
    words = f" {info.get('ID', '')} {info.get('ID_LIKE', '')} "
    for f in ("ubuntu", "debian", "fedora", "arch"):  # ubuntu first: Mint & co say "ubuntu debian"
        if f" {f} " in words:
            return f
    return ""


def hint(dist, package):
    return {
        "arch:protontricks": "sudo pacman -S protontricks",
        "debian:protontricks": "sudo apt install pipx winetricks && pipx install protontricks   (winetricks needs \"contrib\")",
        "ubuntu:protontricks": "sudo add-apt-repository multiverse && sudo apt install protontricks",
        "fedora:protontricks": "sudo dnf install protontricks",
        "immutable:protontricks": f"flatpak install flathub {FLATPAK_ID}",
    }.get(f"{dist}:{package}", "")


# ── backend ──────────────────────────────────────────────────────────────────
def have_native():
    return bool(shutil.which("protontricks") and shutil.which("protontricks-launch"))


def have_flatpak():
    if not shutil.which("flatpak"):
        return False
    return subprocess.run(["flatpak", "info", FLATPAK_ID], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0


class Protontricks:
    def __init__(self, kind):
        self.kind = kind
        if kind == "native":
            self.list, self.launch = ["protontricks"], ["protontricks-launch"]
        else:
            self.list = ["flatpak", "run", FLATPAK_ID]
            self.launch = ["flatpak", "run", "--command=protontricks-launch", FLATPAK_ID]


def detect_protontricks(force):
    """Protontricks to use, or None if it isn't installed."""
    if force == "native":
        return Protontricks("native") if have_native() else None
    if force == "flatpak":
        return Protontricks("flatpak") if have_flatpak() else None
    if have_native():
        return Protontricks("native")
    if have_flatpak():
        return Protontricks("flatpak")
    return None


def read_text(path):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as fh:
            return fh.read()
    except OSError:
        return ""


def steam_roots(steam_dir):
    roots = [steam_dir, "~/.local/share/Steam", "~/.steam/steam", "~/.steam/root", "~/.steam/debian-installation",
             "~/.var/app/com.valvesoftware.Steam/.local/share/Steam", "~/snap/steam/common/.local/share/Steam"]
    roots = [os.path.expanduser(r) for r in roots if r]
    return sorted({os.path.realpath(r) for r in roots if os.path.isdir(os.path.join(r, "steamapps"))})


def steam_libs(steam_dir):
    libs = set()
    for root in steam_roots(steam_dir):
        libs.add(root)
        for m in re.finditer(r'^[ \t]*"path"[ \t]*"(.*)"', read_text(f"{root}/steamapps/libraryfolders.vdf"), re.M):
            if os.path.isdir(os.path.join(m.group(1), "steamapps")):
                libs.add(os.path.realpath(m.group(1)))
    return sorted(libs)


def vdf_field(text, key):
    m = re.search(r'^[ \t]*"%s"[ \t]*"(.*)"' % key, text, re.M)
    return m.group(1) if m else ""


def scan_steam(steam_dir):
    out = []
    for lib in steam_libs(steam_dir):
        for acf in sorted(glob.glob(f"{lib}/steamapps/appmanifest_*.acf")):
            appid = acf.rsplit("_", 1)[1][:-4]
            if os.path.isdir(f"{lib}/steamapps/compatdata/{appid}/pfx"):
                out.append((appid, vdf_field(read_text(acf), "name") or f"App {appid}"))
    return out


def list_games(pt, steam_dir):
    """[(appid, name)] for every non-Steam game with a Proton prefix, sorted by name."""
    games = []
    try:
        res = subprocess.run(pt.list + ["-l"], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL, text=True, errors="replace")
        for line in res.stdout.splitlines():
            if m := re.fullmatch(r"(.*) \(([0-9]+)\)\s*", line):
                games.append((m.group(2), m.group(1)))
    except OSError:
        pass
    if not games:
        games = scan_steam(steam_dir)
    # Only non-Steam shortcuts (their AppIDs are 2147483648 and up).
    games = [g for g in games if g[1].startswith("Non-Steam shortcut") or int(g[0]) >= 2147483648]
    return sorted(set(games), key=lambda g: (g[1].casefold(), g[0]))


def short_name(name):
    return name[len("Non-Steam shortcut: "):] if name.startswith("Non-Steam shortcut: ") else name


def parse_binvdf(d):
    """Binary VDF (shortcuts.vdf) → nested dicts with lower-case keys."""
    p = 0
    sizes = {2: 4, 3: 4, 7: 8, 10: 8}

    def cstr():
        nonlocal p
        z = d.index(b"\0", p)
        s, p = d[p:z], z + 1
        return s

    def node():
        nonlocal p
        obj = {}
        while p < len(d):
            t = d[p]
            p += 1
            if t == 8:
                return obj
            k = cstr().decode("utf-8", "surrogateescape").lower()
            if t == 0:
                obj[k] = node()
            elif t == 1:
                obj[k] = cstr().decode("utf-8", "surrogateescape")
            elif t in sizes:
                obj[k] = int.from_bytes(d[p:p + 4], "little")
                p += sizes[t]
            else:
                raise ValueError(f"unknown VDF type {t}")
        return obj

    return node()


def game_dir(appid, name, steam_dir):
    """(folder, source) of the game's install folder, or (None, None)."""
    for lib in steam_libs(steam_dir):
        d = vdf_field(read_text(f"{lib}/steamapps/appmanifest_{appid}.acf"), "installdir")
        if d and os.path.isdir(f"{lib}/steamapps/common/{d}"):
            return f"{lib}/steamapps/common/{d}", "Steam install folder"
    # Non-Steam shortcut: read the StartDir / Exe of the matching AppName.
    want = short_name(name)
    for root in steam_roots(steam_dir):
        for f in sorted(glob.glob(f"{root}/userdata/*/config/shortcuts.vdf")):
            try:
                with open(f, "rb") as fh:
                    tree = parse_binvdf(fh.read())
            except (OSError, ValueError):
                continue
            sd = exe = ""
            for sc in (tree.get("shortcuts") or {}).values():
                if isinstance(sc, dict) and sc.get("appname") == want:
                    sd = str(sc.get("startdir", "")).replace('"', "")
                    exe = re.sub(r"/[^/]*$", "", str(sc.get("exe", "")).replace('"', ""))
            for d in (sd, exe):
                if d.startswith("/") and os.path.isdir(d):
                    return (d[:-1] if d.endswith("/") and len(d) > 1 else d), "non-Steam shortcut start folder"
    return None, None


REDIST_NAMES = {"_commonredist", "commonredist", "_redist", "redist", "redists", "_installer",
                "__installer", "installers", "directx", "vcredist"}


def is_installer(name):
    return name.lower().endswith((".exe", ".msi"))


def count_installers(top):
    n = 0
    for dirpath, _, files in os.walk(top):
        n += sum(1 for f in files if is_installer(f) and os.path.isfile(os.path.join(dirpath, f))
                 and not os.path.islink(os.path.join(dirpath, f)))
    return n


def find_redist_dirs(top, timeout=5):
    """[(count, dir)] for every _CommonRedist-like folder, best match first."""
    deadline = time.monotonic() + timeout
    hits = []

    def walk(d, depth):
        if time.monotonic() > deadline:
            return
        try:
            entries = sorted(os.scandir(d), key=lambda e: e.name)
        except OSError:
            return
        for e in entries:
            if e.name.startswith(".") or not e.is_dir(follow_symlinks=False):
                continue
            low = e.name.lower()
            if low in REDIST_NAMES or low.startswith("redistributable"):
                hits.append(e.path)
            elif depth < 5:
                walk(e.path, depth + 1)

    walk(top, 1)
    out = [(n, d) for d in hits if (n := count_installers(d))]
    return sorted(out, key=lambda x: (0 if x[1].lower().endswith("commonredist") else 1, x[1].count("/"), x[1]))


def search_redists(appid, name, opts, progress):
    """Locate the game folder and its redist folders (the CLI's folder step)."""
    gamedir, src = game_dir(appid, name, opts.steam_dir)
    res = {"gamedir": gamedir, "src": src, "root": gamedir, "up": 0, "found": []}
    if not gamedir:
        return res
    root, up = gamedir, 0
    found = find_redist_dirs(root)
    # Non-Steam shortcuts often start in a sub-folder (bin/, Binaries/…), so
    # climb up to max_up levels, stopping at the first level with a hit. Never
    # search $HOME itself or above it (other games' installers live there), nor /.
    if not found and src.startswith("non-Steam"):
        while not found and up < opts.max_up:
            parent = os.path.dirname(root)
            if parent in (root, "/"):
                break
            if gamedir.startswith(HOME + "/") and not parent.startswith(HOME + "/"):
                break
            root, up = parent, up + 1
            progress(f"Nothing yet; searching {up} level(s) up: {root}")
            found = find_redist_dirs(root)
    res.update(root=root, up=up, found=found)
    return res


def normalize(s):
    s = s.strip()
    if len(s) >= 2 and s[0] == s[-1] and s[0] in "\"'":
        s = s[1:-1]
    if s.startswith("file://"):
        s = urllib.parse.unquote(s[len("file://"):])
    s = s.replace("\\ ", " ")
    if s.startswith("~"):
        s = HOME + s[1:]
    return s


def find_exes(top, recursive):
    out = []
    if recursive:
        for dirpath, dirs, files in os.walk(top):
            out += [os.path.join(dirpath, f) for f in files]
    else:
        try:
            out = [e.path for e in os.scandir(top)]
        except OSError:
            pass
    out = [p for p in out if is_installer(p) and os.path.isfile(p) and not os.path.islink(p)]
    return sorted(out, key=lambda p: (p.upper(), p))


def check_folder(path):
    """(realpath, None) or (None, error message)."""
    d = normalize(path)
    if os.path.isfile(d) and is_installer(d):
        d = os.path.dirname(d)
    if not d or not os.path.exists(d):
        return None, f"Not found: {d}"
    if not os.path.isdir(d):
        return None, "That's a file, not a folder."
    if not os.access(d, os.R_OK | os.X_OK):
        return None, f"Permission denied. Try: chmod -R u+rX {shlex.quote(d)}"
    return os.path.realpath(d), None


def silent_flags(path):
    n = os.path.basename(path).lower()
    for pats, flags in ((["*.msi"], "/qn /norestart"),
                        (["vc_redist[._-]*"], "/install /quiet /norestart"),
                        (["vcredist*"], "/q"),
                        (["dxsetup.exe"], "/silent"),
                        (["ndp*", "dotnet*", "netfx*", "windowsdesktop-runtime*"], "/q /norestart"),
                        (["oalinst.exe"], "/s")):
        if any(fnmatch.fnmatchcase(n, p) for p in pats):
            return flags
    return ""


def install_cmd(pt, appid, exe, silent):
    flags = silent_flags(exe) if silent else ""
    if exe.lower().endswith(".msi"):
        # Wine can't run an .msi directly; hand it to msiexec inside the prefix.
        return pt.list + ["-c", f"wine msiexec /i {shlex.quote(exe)}" + (f" {flags}" if flags else ""), appid]
    return pt.launch + ["--appid", appid, exe] + flags.split()


# ── Steam launch options ─────────────────────────────────────────────────────
# Get/set LaunchOptions in localconfig.vdf (text) or shortcuts.vdf (binary),
# editing only that value in place; everything else stays byte-for-byte.
def merge_launch(cur, new, replace):
    cur, new = (cur or "").strip(), (new or "").strip()
    if replace or not cur or "%command%" not in new:
        return new
    if cur == new:
        return cur
    prefix, suffix = new.split("%command%", 1)
    for var in re.findall(r"(?:^|\s)(\w+)=", prefix):
        cur = re.sub(r'(?:^|(?<=\s))%s=(?:"[^"]*"|\S*)\s*' % re.escape(var), "", cur)
    cur = cur.strip()
    rest = (cur if "%command%" in cur else f"%command% {cur}").rstrip()
    return " ".join(x for x in (prefix.strip(), rest.strip(), suffix.strip()) if x)


_TOKEN = re.compile(rb'"((?:[^"\\]|\\.)*)"|([{}])|//[^\n]*|\s+', re.S)


def _locate(kind, d, appid, name):
    """→ (found, cur bytes, start, end, insert_at, insert_bytes_template)"""
    found, cur, s, e, ins, text = False, b"", None, None, None, None
    if kind == "localconfig":
        want = [b"userlocalconfigstore", b"software", b"valve", b"steam", b"apps", appid.encode()]
        path, pending, apps_close, pos = [], None, None, 0

        def at(n):
            return len(path) == n and [x.lower() for x in path] == want[:n]

        while m := _TOKEN.match(d, pos):
            pos = end = m.end()
            if pos == m.start():
                break
            string, br = m.group(1), m.group(2)
            if string is not None:
                if pending is None:
                    pending = string
                    continue
                if at(6) and pending.lower() == b"launchoptions":
                    found, s, e = True, end - len(string) - 1, end - 1
                    cur = re.sub(rb"\\(.)", rb"\1", string, flags=re.S)
                pending = None
            elif br == b"{":
                path.append(pending or b"")
                pending = None
            elif br == b"}":
                line = d.rfind(b"\n", 0, end) + 1
                if at(6) and ins is None:
                    ins, text = line, b"\t" * 6 + b'"LaunchOptions"\t\t"%s"\n'
                if at(5):
                    apps_close = line
                if path:
                    path.pop()
        if ins is None and apps_close is not None:  # app block missing: create it
            ins = apps_close
            text = (b"\t" * 5 + b'"' + appid.encode() + b'"\n' + b"\t" * 5 + b"{\n"
                    + b"\t" * 6 + b'"LaunchOptions"\t\t"%s"\n' + b"\t" * 5 + b"}\n")
        return found or ins is not None, cur, s, e, ins, text

    p, sizes = 0, {2: 4, 3: 4, 7: 8, 10: 8}
    want_name = name.encode("utf-8", "surrogateescape")
    state = {"found": False}

    def cstr():
        nonlocal p
        z = d.find(b"\0", p)
        if z < 0:
            raise ValueError("bad VDF")
        x, p = d[p:z], z + 1
        return x

    def node(lvl):
        nonlocal p, cur, s, e, ins, text
        f = {}
        while p < len(d):
            t = d[p]
            p += 1
            if t == 8:
                if lvl == 2 and not state["found"] and (
                        ("id" in f and str(f["id"]) == appid) or ("name" in f and f["name"] == want_name)):
                    state["found"] = True
                    if "s" in f:
                        cur, s, e = f["v"], f["s"], f["e"]
                    else:
                        ins, text = p - 1, b"\x01LaunchOptions\x00%s\x00"
                return
            k = cstr().lower()
            if t == 0:
                node(lvl + 1)
            elif t == 1:
                vs = p
                v = cstr()
                if lvl == 2:
                    if k == b"appname":
                        f["name"] = v
                    if k == b"launchoptions":
                        f.update(v=v, s=vs, e=p - 1)
            elif t in sizes:
                raw = d[p:p + sizes[t]]
                p += sizes[t]
                if lvl == 2 and k == b"appid":
                    f["id"] = int.from_bytes(raw[:4], "little")
            else:
                raise ValueError(f"unknown VDF type {t}")

    node(0)
    return state["found"], cur, s, e, ins, text


def vdf_get(kind, file, appid, name=""):
    """Current launch options, or None if the game isn't in the file."""
    with open(file, "rb") as fh:
        found, cur, *_ = _locate(kind, fh.read(), appid, name)
    return cur.decode("utf-8", "surrogateescape") if found else None


def vdf_set(kind, file, appid, name, value):
    with open(file, "rb") as fh:
        d = fh.read()
    _, _, s, e, ins, text = _locate(kind, d, appid, name)
    val = value.encode("utf-8", "surrogateescape")
    if kind == "localconfig":
        val = re.sub(rb'(["\\])', rb"\\\1", val)
    if s is not None:
        d = d[:s] + val + d[e:]
    elif ins is not None:
        d = d[:ins] + text.replace(b"%s", val, 1) + d[ins:]
    else:
        raise ValueError(f"game not found in {file}")
    mode = os.stat(file).st_mode & 0o7777
    tmp = f"{file}.redinstaller-tmp"
    with open(tmp, "wb") as out:
        out.write(d)
    os.chmod(tmp, mode)
    os.rename(tmp, file)


def launch_targets(appid, name, steam_dir):
    """[(kind, file, current)] for every place this game's launch options live."""
    out = []
    for root in steam_roots(steam_dir):
        if name.startswith("Non-Steam shortcut") or int(appid) >= 2147483648:
            for f in sorted(glob.glob(f"{root}/userdata/*/config/shortcuts.vdf")):
                try:
                    cur = vdf_get("shortcuts", f, appid, short_name(name))
                except (OSError, ValueError):
                    continue
                if cur is not None:
                    out.append(("shortcuts", f, cur))
        else:
            # logged-in account: MostRecent in loginusers.vdf, else newest localconfig.vdf
            sid, uid = None, None
            for line in read_text(f"{root}/config/loginusers.vdf").splitlines():
                if m := re.match(r'^\t"([0-9]+)"', line):
                    sid = m.group(1)
                if re.search(r'"MostRecent"\s+"1"', line) and sid:
                    uid = sid
                    break
            user = f"{root}/userdata/{int(uid) - 76561197960265728}" if uid else None
            if not (user and os.path.isfile(f"{user}/config/localconfig.vdf")):
                cands = [f for f in glob.glob(f"{root}/userdata/*/config/localconfig.vdf") if "/userdata/0/" not in f]
                user = os.path.dirname(os.path.dirname(max(cands, key=os.path.getmtime))) if cands else None
            if not user:
                continue
            f = f"{user}/config/localconfig.vdf"
            try:
                cur = vdf_get("localconfig", f, appid)
            except (OSError, ValueError):
                continue
            if cur is not None:
                out.append(("localconfig", f, cur))
    return out


def write_launch(kind, file, appid, name, new):
    """Back the file up, then write; → (ok, message)."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    backup, n = f"{file}.redinstaller-{stamp}.bak", 1
    while os.path.exists(backup):
        n += 1
        backup = f"{file}.redinstaller-{stamp}-{n}.bak"
    try:
        shutil.copy2(file, backup)
        vdf_set(kind, file, appid, short_name(name), new)
    except (OSError, ValueError) as err:
        return False, f"✘ Launch options: couldn't write {file}: {err}"
    return True, f"✔ Launch options set → {new} (backup: {backup})"


def steam_running():
    return subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL).returncode == 0


def shutdown_steam():
    if shutil.which("steam"):
        cmd = ["steam", "-shutdown"]
    elif shutil.which("flatpak"):
        cmd = ["flatpak", "run", "com.valvesoftware.Steam", "-shutdown"]
    else:
        return False
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    for _ in range(45):
        if not steam_running():
            time.sleep(2)
            return True
        time.sleep(1)
    return False


