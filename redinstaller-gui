        silent = Adw.SwitchRow(title="Use silent installs", active=True,
                               subtitle="Pass quiet flags to known installers (VC++, DirectX, .NET, OpenAL, .msi) so "
                                        "you don't have to click through each one. Unknown installers still open normally.")
        g1.add(silent)
        page.add(g1)

        nat = "installed" if have_native() else "not installed"
        flat = "installed" if have_flatpak() else "not installed"
        g2 = group("Which Protontricks?")
        pt = ChoiceRow("Protontricks", ["auto", "native", "flatpak"],
                       f"auto (recommended) uses the native one if it's there, otherwise Flatpak. "
                       f"Native: {nat}. Flatpak: {flat}.")
        g2.add(pt)
        page.add(g2)

        g3 = group("Steam launch options", f"Redinstaller can also set the game's launch options in Steam to: "
                                           f"{cfg['launch_options_value']}")
        lo = ChoiceRow("Set launch options", ["Ask each time", "Always", "Never"],
                       "Ask each time is recommended. Always keeps your other launch options.")
        g3.add(lo)
        page.add(g3)

        g4 = group("Redist folder")
        auto = Adw.SwitchRow(title="Auto-pick the found folder", active=False,
                             subtitle="When a _CommonRedist-style folder is found in the game's folder, use it "
                                      "straight away instead of showing the folder list.")
        g4.add(auto)
        page.add(g4)

        saved = {"done": False}

        def save(_b):
            cfg["silent"] = "true" if silent.get_active() else "false"
            cfg["protontricks"] = ("auto", "native", "flatpak")[pt.get_selected()]
            cfg["launch_options"] = ("ask", "always", "never")[lo.get_selected()]
            if cfg["launch_options"] == "always":
                cfg["launch_options_mode"] = "merge"
            cfg["auto_pick_folder"] = "true" if auto.get_active() else "false"
            self.cfg = cfg
            try:
                cfg_save(cfg)
                self.toast(f"Saved your settings to {CONFIG_FILE}")
            except OSError:
                self.toast(f"Couldn't save {CONFIG_FILE}; using these answers for this run only.", 6)
            saved["done"] = True
            d.close()

        def closed(_d):
            if not saved["done"]:
                self.toast("Setup skipped; using the defaults this time.")
                self.cfg = cfg_defaults()
            self.load_games()

        btn = Gtk.Button(label="Save and continue", halign=Gtk.Align.CENTER, margin_top=6, margin_bottom=12)
        btn.add_css_class("pill")
        btn.add_css_class("suggested-action")
        btn.connect("clicked", save)
        tv = Adw.ToolbarView(content=page)
        tv.add_top_bar(Adw.HeaderBar())
        tv.add_bottom_bar(btn)
        d.set_child(tv)
        d.connect("closed", closed)
        d.present(self)

    # ── step 1: game ──
    def show_games(self, subtitle):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=12, margin_bottom=12,
                      margin_start=12, margin_end=12)
        if self.opts.show_banner:
            tag = Gtk.Label(label="Windows redistributables → Steam Proton prefixes, via Protontricks", wrap=True)
            tag.add_css_class("tagline")
            tip = Gtk.Label(label="Pick a game, pick the _CommonRedist folder, confirm.", wrap=True)
            tip.add_css_class("dim-label")
            box.append(tag)
            box.append(tip)
        search = Gtk.SearchEntry(placeholder_text=f"Search {len(self.games)} non-Steam games")
        search.set_key_capture_widget(self)
        box.append(search)
        lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, valign=Gtk.Align.START)
        lb.add_css_class("boxed-list")
        for appid, name in self.games:
            r = row(name, f"AppID {appid}", activatable=True)
            r.appid, r.name = appid, name
            r.connect("activated", lambda r: self.pick_game(r.appid, r.name))
            lb.append(r)
        query = {"q": ""}
        lb.set_filter_func(lambda r: query["q"] in f"{r.name}  |  {r.appid}".casefold())

        def changed(e):
            query["q"] = e.get_text().casefold()
            lb.invalidate_filter()
        search.connect("search-changed", changed)

        def activate(_e):  # Enter picks the first match
            i = 0
            while (r := lb.get_row_at_index(i)) is not None:
                if query["q"] in f"{r.name}  |  {r.appid}".casefold():
                    self.pick_game(r.appid, r.name)
                    return
                i += 1
        search.connect("activate", activate)
        box.append(lb)
        scroller = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER,
                                      child=Adw.Clamp(maximum_size=720, child=box))
        self.set_root(toolbar_page("Games", scroller, header=self.header(subtitle, root=True)))

    def pick_game(self, appid, name):
        self.game = (appid, name)
        if ARGS.folder:
            folder, ARGS.folder = ARGS.folder, None
            self.use_folder(folder, self.opts.recursive)
            return
        self.show_folder_step()

    # ── step 2: folder ──
    def show_folder_step(self):
        appid, name = self.game
        page_box = Adw.PreferencesPage()
        progress = Gtk.Label(wrap=True, label="Looking for the game's install folder…")
        progress.add_css_class("dim-label")
        loading = status(None, "Searching for redistributables", spinner=True, child=progress)
        stack = Gtk.Stack()
        stack.add_named(loading, "loading")
        stack.add_named(page_box, "done")
        page = toolbar_page(name, stack, header=self.header(f"{name} ({appid})"))
        self.nav.push(page)

        def report(text):
            GLib.idle_add(lambda: progress.set_label(text) and False)

        def done(res, err):
            if err:
                res = {"gamedir": None, "src": None, "root": None, "up": 0, "found": []}
            self.fill_folder_page(page_box, res)
            stack.set_visible_child_name("done")
            if self.opts.auto_pick and res["found"] and self.nav.get_visible_page() is page:
                self.toast("Using the best match (auto-pick is on)")
                self.use_folder(res["found"][0][1], True)
        bg(search_redists, appid, name, self.opts, report, done=done)

    def fill_folder_page(self, pp, res):
        gamedir, src, top, up, found = res["gamedir"], res["src"], res["root"], res["up"], res["found"]
        g = group("Game folder")
        if gamedir:
            r = row(gamedir, src, icon=("folder-symbolic",), selectable=True)
            g.add(r)
        else:
            g.add(row("Couldn't locate the game's install folder.", "Browse or enter a path below.",
                      icon=("dialog-warning-symbolic", "warning")))
        pp.add(g)

        if gamedir:
            if found:
                desc = f"Found {len(found)} candidate folder(s)" + (f" {up} level(s) above the game folder" if up else "")
            elif src.startswith("non-Steam"):
                desc = (f"No _CommonRedist-style folder in the game folder or {up} level(s) above it "
                        f"(searched up to {top}). Browse or enter a custom path instead.")
            else:
                desc = "No _CommonRedist-style folder in the game folder. Browse or enter a custom path instead."
            g2 = group("Redistributable folders", desc)
            for n, d in found:
                r = row(os.path.relpath(d, top), f"{n} installer(s)", activatable=True,
                        icon=("package-x-generic-symbolic",))
                r.path = d
                r.connect("activated", lambda r: self.use_folder(r.path, True))
                g2.add(r)
            pp.add(g2)

        g3 = group("Another folder")
        start = gamedir or HOME
        b = row(f"Browse {'the game folder' if gamedir else 'your home folder'}…", start,
                activatable=True, icon=("folder-open-symbolic",))
        b.connect("activated", lambda _r: self.browse(start))
        g3.add(b)
        e = Adw.EntryRow(title="Enter a custom path", show_apply_button=True, use_markup=False)
        e.connect("apply", lambda e: self.use_folder(e.get_text(), self.opts.recursive))
        g3.add(e)
        pp.add(g3)

    def browse(self, start):
        d = Gtk.FileDialog(title="Folder with the redistributables", modal=True)
        d.set_initial_folder(Gio.File.new_for_path(start))

        def done(dlg, result):
            try:
                f = dlg.select_folder_finish(result)
            except GLib.Error:
                return
            if f and f.get_path():
                self.use_folder(f.get_path(), True)
        d.select_folder(self, None, done)

    def use_folder(self, path, recursive):
        d, err = check_folder(path)
        if err:
            self.toast(err, 5)
            return
        exes = find_exes(d, recursive)
        if not exes:
            if not recursive:
                self.alert("No installers at the top level",
                           f"There are no .exe or .msi files directly in {d}. Search its sub-folders?",
                           [("cancel", "Cancel", None), ("yes", "Search sub-folders", Adw.ResponseAppearance.SUGGESTED)],
                           lambda r: r == "yes" and self.use_folder(d, True), default="yes")
            else:
                self.toast("No .exe or .msi files anywhere in that folder.", 5)
            return
        self.folder, self.exes, self.recursive = d, exes, recursive
        o = self.opts
        if not o.confirm and o.launch is not None and not (o.launch and o.launch_mode == "ask"):
            self.quick_install()
        else:
            self.show_review()

    # ── step 3: review ──
    def show_review(self):
        appid, name = self.game
        o = self.opts
        pp = Adw.PreferencesPage()
        n_msi = sum(1 for e in self.exes if e.lower().endswith(".msi"))

        g = group("Summary")
        mode_row = row("Mode", mode_text(o.silent, o.dry_run, self.recursive))
        for r in (row("Game", name), row("AppID", appid, selectable=True),
                  row("Files", f"{len(self.exes) - n_msi} .exe, {n_msi} .msi"),
                  row("Folder", self.folder, selectable=True), mode_row):
            r.add_css_class("property")
            g.add(r)
        pp.add(g)

        g2 = group("Options")
        silent = Adw.SwitchRow(title="Silent installs", active=o.silent,
                               subtitle="Quiet flags for VC++, DirectX, .NET, OpenAL and .msi installers")
        dry = Adw.SwitchRow(title="Dry run", active=o.dry_run, subtitle="Show the commands without running anything")
        g2.add(silent)
        g2.add(dry)
        pp.add(g2)

        g3 = group("Installers", f"{len(self.exes)} file(s), installed in this order")
        file_rows = []
        for e in self.exes:
            r = row(os.path.relpath(e, self.folder), icon=("application-x-executable-symbolic",))
            r.exe = e
            file_rows.append(r)
            g3.add(r)
        pp.add(g3)

        def refresh(*_):
            mode_row.set_subtitle(mode_text(silent.get_active(), dry.get_active(), self.recursive))
            for r in file_rows:
                r.set_subtitle(silent_flags(r.exe) if silent.get_active() else "")
        silent.connect("notify::active", refresh)
        dry.connect("notify::active", refresh)
        refresh()

        if self.pt.kind == "flatpak":
            cmd = f"flatpak override --user --filesystem={shlex.quote(self.folder)}:ro {FLATPAK_ID}"
            g4 = group("Flatpak access", "Flatpak Protontricks can only read folders it was granted. "
                                         "If installs fail, run:")
            r = row(cmd, selectable=True, icon=("dialog-warning-symbolic", "warning"))
            r.add_suffix(copy_button(cmd))
            g4.add(r)
            pp.add(g4)

        # launch options
        g5 = group("Steam launch options")
        exp = Adw.ExpanderRow(title=f"Also set launch options for {name}", show_enable_switch=True,
                              use_markup=False, enable_expansion=bool(o.launch), expanded=bool(o.launch))
        val = Adw.EntryRow(title="Launch options", text=o.launch_value, use_markup=False)
        mode = ChoiceRow("Existing launch options", ["Merge", "Replace"], "Merge keeps the game's other options")
        mode.set_selected(1 if o.launch_mode == "replace" else 0)
        exp.add_row(val)
        exp.add_row(mode)
        g5.add(exp)
        targets_group = group()
        pp.add(g5)
        pp.add(targets_group)
        state = {"targets": None, "loading": False, "rows": []}

        install_btn = Gtk.Button(label=f"Install {len(self.exes)} file(s)", halign=Gtk.Align.CENTER,
                                 margin_top=6, margin_bottom=12)
        install_btn.add_css_class("pill")
        install_btn.add_css_class("suggested-action")

        def show_targets():
            for r in state["rows"]:
                targets_group.remove(r)
            state["rows"] = []
            if not exp.get_enable_expansion():
                targets_group.set_visible(False)
                install_btn.set_sensitive(True)
                return
            targets_group.set_visible(True)
            if state["targets"] is None:
                rows = [row("Checking Steam's config…", icon=("content-loading-symbolic",))]
                install_btn.set_sensitive(False)
            elif not state["targets"]:
                rows = [row("This game isn't in your Steam config", "Launch options will be skipped.",
                            icon=("dialog-warning-symbolic", "warning"))]
                install_btn.set_sensitive(True)
            else:
                rows = []
                for kind, file, cur, new in self.launch_plan(state["targets"], val.get_text(), mode.get_selected() == 1):
                    title = "Steam game" if kind == "localconfig" else "Non-Steam shortcut"
                    if new == cur:
                        sub = f"{file}\n✔ already set: {cur}"
                    else:
                        sub = f"{file}\nnow: {cur or '(none)'}\nnew: {new}"
                    rows.append(row(title, sub, selectable=True))
                install_btn.set_sensitive(True)
            for r in rows:
                targets_group.add(r)
            state["rows"] = rows

        def enabled(*_):
            if exp.get_enable_expansion() and state["targets"] is None and not state["loading"]:
                state["loading"] = True

                def got(res, err):
                    state["targets"] = res or []
                    show_targets()
                bg(launch_targets, appid, name, o.steam_dir, done=got)
            show_targets()
        exp.connect("notify::enable-expansion", enabled)
        val.connect("changed", lambda *_: show_targets())
        mode.on_change(lambda *_: show_targets())
        enabled()

        def install(_b):
            plan = []
            if exp.get_enable_expansion() and state["targets"]:
                v = val.get_text().strip() or DEFAULT_LAUNCH
                plan = [p for p in self.launch_plan(state["targets"], v, mode.get_selected() == 1) if p[3] != p[2]]
            self.run_install(silent.get_active(), dry.get_active(), plan)
        install_btn.connect("clicked", install)

        page = toolbar_page("Review", pp, header=self.header(f"{name} ({appid})"), bottom=install_btn)
        self.nav.push(page)

    def launch_plan(self, targets, value, replace):
        return [(kind, file, cur, merge_launch(cur, value or DEFAULT_LAUNCH, replace)) for kind, file, cur in targets]

    def quick_install(self):
        """confirm_install is off and nothing needs asking: go straight to installing."""
        appid, name = self.game
        o = self.opts
        if not o.launch:
            self.run_install(o.silent, o.dry_run, [])
            return

        def got(res, err):
            plan = [p for p in self.launch_plan(res or [], o.launch_value, o.launch_mode == "replace") if p[3] != p[2]]
            if not res:
                self.toast("This game isn't in your Steam config; launch options skipped.", 5)
            self.run_install(o.silent, o.dry_run, plan)
        bg(launch_targets, appid, name, o.steam_dir, done=got)

    # ── step 4: install ──
    def run_install(self, silent, dry, plan):
        appid, name = self.game
        self.launch_log = []
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=12, margin_bottom=12,
                      margin_start=12, margin_end=12)
        self.cur_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, label="Preparing…")
        self.cur_label.add_css_class("heading")
        self.bar = Gtk.ProgressBar(show_text=True, text=f"0/{len(self.exes)}")
        box.append(self.cur_label)
        box.append(self.bar)
        self.logbuf = Gtk.TextBuffer()
        for tag, props in (("cmd", {"foreground": "#8a8a8a"}), ("out", {}),
                           ("ok", {"foreground": "#26a269", "weight": 700}),
                           ("err", {"foreground": "#e01b24", "weight": 700}),
                           ("warn", {"foreground": "#c88800", "weight": 700}),
                           ("head", {"weight": 700})):
            self.logbuf.create_tag(tag, **props)
        self.logview = Gtk.TextView(buffer=self.logbuf, editable=False, cursor_visible=False, monospace=True,
                                    wrap_mode=Gtk.WrapMode.WORD_CHAR)
        self.logview.add_css_class("log")
        self.logend = self.logbuf.create_mark("end", self.logbuf.get_end_iter(), False)
        frame = Gtk.Frame(child=Gtk.ScrolledWindow(child=self.logview, vexpand=True))
        box.append(frame)

        bottom = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER, margin_top=6, margin_bottom=12)
        self.skip_btn = Gtk.Button(label="Skip this installer", tooltip_text="Stops the running installer (like Ctrl+C)")
        self.skip_btn.add_css_class("pill")
        self.skip_btn.connect("clicked", lambda _b: self.runner and self.runner.skip())
        self.summary_btn = Gtk.Button(label="Show summary", visible=False)
        self.summary_btn.add_css_class("pill")
        self.summary_btn.add_css_class("suggested-action")
        self.summary_btn.connect("clicked", lambda _b: self.nav.push(self.summary_page))
        self.games_btn = Gtk.Button(label="Back to games", visible=False)
        self.games_btn.add_css_class("pill")
        self.games_btn.connect("clicked", lambda _b: self.back_to_games())
        for b in (self.skip_btn, self.games_btn, self.summary_btn):
            bottom.append(b)
        self.progress_page = toolbar_page("Installing", box, header=self.header(f"{name} ({appid})"),
                                          bottom=bottom, can_pop=False)
        self.nav.push(self.progress_page)
        self.runner = InstallRunner(self, self.pt, appid, self.folder, self.exes, silent, dry, self.opts.verbose)
        self.skip_btn.set_sensitive(False)

        if self.pt.kind == "flatpak":
            self.run_log("Flatpak Protontricks can only read folders it was granted. If installs fail, run:\n"
                         f"  flatpak override --user --filesystem={shlex.quote(self.folder)}:ro {FLATPAK_ID}", "warn")
        if not plan:
            self.start_runner()
        elif dry:
            self.launch_log.append("✔ Launch options (dry run, not written)")
            for kind, file, cur, new in plan:
                self.run_log(f"Launch options (dry run): {file}\n  now  {cur or '(none)'}\n  new  {new}", "cmd")
            self.start_runner()
        elif steam_running():
            self.run_log("Steam is running. It rewrites its config when it exits, so the change would be lost.", "warn")
            if self.opts.close_steam == "ask":
                self.alert("Close Steam?",
                           "Steam has to be closed to save the launch options, because it rewrites its config when "
                           "it exits. Closing Steam also closes any game running through Steam.",
                           [("skip", "Skip launch options", None),
                            ("close", "Close Steam", Adw.ResponseAppearance.DESTRUCTIVE)],
                           lambda r: self.close_steam_then(plan) if r == "close" else self.skip_launch())
            else:
                self.skip_launch()
        else:
            self.write_plan(plan)

    def skip_launch(self):
        self.launch_log.append("⚠ Launch options: skipped (Steam was running)")
        self.run_log("⚠ Launch options skipped (Steam was running)", "warn")
        self.start_runner()

    def close_steam_then(self, plan):
        self.cur_label.set_label("Waiting for Steam to exit…")
        self.run_log("› Waiting for Steam to exit…", "head")

        def done(ok, err):
            if ok:
                self.run_log("✔ Steam closed; start it again when you're done.", "ok")
                self.write_plan(plan)
            else:
                self.launch_log.append("✘ Launch options: Steam didn't exit in time; not written")
                self.run_log("✘ Steam didn't exit in time; launch options not written", "err")
                self.start_runner()
        bg(shutdown_steam, done=done)

    def write_plan(self, plan):
        appid, name = self.game

        def work():
            return [write_launch(kind, file, appid, name, new) for kind, file, cur, new in plan]

        def done(res, err):
            for ok, msg in res or [(False, f"✘ Launch options: {err}")]:
                self.launch_log.append(msg)
                self.run_log(msg, "ok" if ok else "err")
            self.start_runner()
        bg(work, done=done)

    def start_runner(self):
        self.skip_btn.set_sensitive(not self.runner.dry)
        self.runner.start()

    def run_log(self, text, tag="out"):
        buf = self.logbuf
        if buf.get_char_count():
            buf.insert(buf.get_end_iter(), "\n")
        buf.insert_with_tags_by_name(buf.get_end_iter(), text, tag)
        self.logview.scroll_to_mark(self.logend, 0, False, 0, 1)

    def run_output(self, text):
        self.run_log("\n".join("│ " + x for x in text.split("\n")), "out")

    def run_started(self, i, total, rel, cmd):
        self.cur_label.set_label(f"[{i + 1}/{total}]  {rel}")
        self.bar.set_fraction(i / total)
        self.bar.set_text(f"{i}/{total}")
        self.run_log(f"[{i + 1}/{total}] {rel}", "head")
        self.run_log(f"$ {cmd}", "cmd")

    def run_ask_continue(self, runner):
        def answer(r):
            runner.go_on = r != "stop"
            runner.answer.set()
        self.alert("Installer skipped", "Continue with the remaining installers?",
                   [("stop", "Stop", None), ("continue", "Continue", Adw.ResponseAppearance.SUGGESTED)],
                   answer, default="continue")

    def run_finished(self, runner):
        self.runner = None
        total = len(self.exes)
        self.bar.set_fraction(1)
        self.bar.set_text(f"{total}/{total}")
        self.cur_label.set_label("Finished")
        self.skip_btn.set_visible(False)
        self.games_btn.set_visible(True)
        self.summary_btn.set_visible(True)
        self.progress_page.set_title("Output")
        self.summary_page = self.make_summary(runner)
        self.nav.push(self.summary_page)

    # ── step 5: summary ──
    def make_summary(self, r):
        appid, name = self.game
        ok, fail, skip = len(r.oks), len(r.fails), len(r.skips)
        pp = Adw.PreferencesPage()
        head = status("emblem-ok-symbolic" if not fail else "dialog-warning-symbolic",
                      "All done" if not (fail or skip) else ("Finished with errors" if fail else "Finished"),
                      f"{ok} succeeded · {fail} failed · {skip} skipped" + (" (dry run)" if r.dry else ""))
        head.add_css_class("compact")
        pg = Adw.PreferencesGroup()
        pg.add(head)
        pp.add(pg)
        g = group(f"Summary for {name} ({appid})")
        for x in r.oks:
            g.add(row(x, icon=("object-select-symbolic", "success")))
        for x in r.fails:
            g.add(row(x, icon=("dialog-error-symbolic", "error")))
        for x in r.skips:
            g.add(row(x, "skipped", icon=("media-skip-forward-symbolic", "warning")))
        for x in self.launch_log:
            icon = {"✔": ("object-select-symbolic", "success"), "✘": ("dialog-error-symbolic", "error")}.get(
                x[0], ("dialog-warning-symbolic", "warning"))
            g.add(row("Steam launch options", x[2:], icon=icon, selectable=True))
        pp.add(g)
        if fail:
            cmd = f"{shlex.join(self.pt.launch)} --appid {appid} /path/to/file.exe"
            g2 = group("Tip", "Turn on “Wine debug output” in Settings and try again, or retry one by hand:")
            rr = row(cmd, selectable=True)
            rr.add_suffix(copy_button(cmd))
            g2.add(rr)
            pp.add(g2)
        bottom = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER, margin_top=6, margin_bottom=12)
        b1 = Gtk.Button(label="Back to games")
        b1.add_css_class("pill")
        b1.add_css_class("suggested-action")
        b1.connect("clicked", lambda _b: self.back_to_games())
        b2 = Gtk.Button(label="Quit")
        b2.add_css_class("pill")
        b2.connect("clicked", lambda _b: self.close())
        bottom.append(b2)
        bottom.append(b1)
        return toolbar_page("Summary", pp, header=self.header(f"{name} ({appid})"), bottom=bottom)

    def back_to_games(self):
        root = self.nav.get_navigation_stack().get_item(0)
        self.nav.pop_to_page(root)

    def on_close(self, _w):
        if not self.runner:
            return False
        def answer(r):
            if r == "quit":
                self.runner.kill()
                self.runner = None
                self.destroy()
        self.alert("Stop installing?", "An installer is still running. Quit and stop it?",
                   [("cancel", "Keep going", None), ("quit", "Stop and quit", Adw.ResponseAppearance.DESTRUCTIVE)],
                   answer)
        return True

    # ── settings ──
    def open_settings(self):
        d = Adw.PreferencesDialog(title="Settings", search_enabled=True)
        page = Adw.PreferencesPage(title="Settings", icon_name="emblem-system-symbolic")
        before = dict(self.cfg)
        widgets = {}
        loading = {"on": False}
        sections = (("Installing", ["silent", "recursive", "auto_pick_folder", "search_levels_up", "confirm_install"]),
                    ("Steam launch options", ["launch_options", "launch_options_value", "launch_options_mode",
                                              "close_steam"]),
                    ("Advanced", ["protontricks", "verbose", "steam_dir", "show_banner"]))

        def save(key, value):
            if loading["on"]:
                return
            self.cfg[key] = value
            try:
                cfg_save(self.cfg)
            except OSError:
                self.toast(f"Couldn't save {CONFIG_FILE}", 5)

        for title, keys in sections:
            g = group(title)
            for k in keys:
                _, t, default, label, desc = SETTING[k]
                if t == "bool":
                    w = Adw.SwitchRow(title=label, subtitle=desc)
                    w.connect("notify::active", lambda w, _p, k=k: save(k, "true" if w.get_active() else "false"))
                elif t == "int":
                    w = Adw.SpinRow.new_with_range(0, 10, 1)
                    w.set_title(label)
                    w.set_subtitle(desc)
                    w.connect("notify::value", lambda w, _p, k=k: save(k, str(int(w.get_value()))))
                elif t == "text":
                    w = Adw.EntryRow(title=label, show_apply_button=True, use_markup=False, tooltip_text=desc)

                    def applied(w, k=k):
                        v = w.get_text()
                        if k == "launch_options_value" and not v.strip():
                            v = DEFAULT_LAUNCH
                            w.set_text(v)
                        if (v := cfg_norm(k, v)) is None:
                            self.toast(f"Invalid value for {SETTING[k][3]}")
                            return
                        save(k, v)
                        self.toast("Saved")
                    w.connect("apply", applied)
                else:
                    choices = t.split("/")
                    w = ChoiceRow(label, choices, desc)
                    w.on_change(lambda w, k=k, c=choices: save(k, c[w.get_selected()]))
                widgets[k] = w
                g.add(w)
            if title == "Steam launch options":
                g.set_description(GLib.markup_escape_text(
                    f"Launch options: {SETTING['launch_options_value'][4]}"))
            if title == "Advanced":
                g.set_description(GLib.markup_escape_text(f"Steam folder: {SETTING['steam_dir'][4]}"))
            page.add(g)

        def load_values():
            loading["on"] = True
            for k, w in widgets.items():
                v, t = self.cfg[k], SETTING[k][1]
                if t == "bool":
                    w.set_active(v == "true")
                elif t == "int":
                    w.set_value(int(v))
                elif t == "text":
                    w.set_text(v)
                else:
                    w.set_selected(t.split("/").index(v))
            loading["on"] = False
        load_values()

        g = group("Config file", CONFIG_FILE)
        open_row = row("Open the config file", "In your text editor", activatable=True,
                       icon=("text-x-generic-symbolic",))

        def open_file(_r):
            if not os.path.exists(CONFIG_FILE):
                try:
                    cfg_save(self.cfg)
                except OSError:
                    pass
            Gtk.FileLauncher.new(Gio.File.new_for_path(CONFIG_FILE)).launch(self, None, None)
        open_row.connect("activated", open_file)
        reset_row = row("Reset everything to defaults", "Puts every setting back to its default and saves.",
                        activatable=True, icon=("edit-undo-symbolic",))

        def reset(_r):
            self.cfg = cfg_defaults()
            load_values()
            try:
                cfg_save(self.cfg)
                self.toast("Settings reset")
            except OSError:
                self.toast(f"Couldn't save {CONFIG_FILE}", 5)
        reset_row.connect("activated", reset)
        g.add(open_row)
        g.add(reset_row)
        page.add(g)
        d.add(page)

        def closed(_d):
            if not ARGS.no_config and os.path.exists(CONFIG_FILE):  # pick up hand edits too
                self.cfg = cfg_defaults()
                cfg_load(self.cfg)
            self.opts = Options(self.cfg, ARGS)
            reload = any(before[k] != self.cfg[k] for k in ("protontricks", "steam_dir", "show_banner"))
            if not self.runner and (reload or not self.pt):
                if self.nav.get_navigation_stack().get_n_items() <= 1 or not self.pt:
                    self.load_games()
                else:
                    self.toast("Protontricks or Steam folder changed: reload the games list from the menu.", 6)
        d.connect("closed", closed)
        d.present(self)

    def show_about(self):
        a = Adw.AboutDialog(application_name="Redinstaller", version=VERSION, developer_name="Jecobe",
                            application_icon="system-software-install",
                            comments="Installs a game's Windows redistributables (VC++, DirectX, .NET, OpenAL, …) "
                                     "into its Steam Proton prefix with Protontricks.",
                            website="https://github.com/Jecobe/redinstaller",
                            issue_url="https://github.com/Jecobe/redinstaller/issues",
                            license_type=Gtk.License.GPL_3_0, copyright="© 2026 Jecobe")
        a.present(self)

    # ── uninstall ──
    def uninstall(self):
        loose, pkgcmd = uninstall_plan()
        lines = [f"• remove {f}" for f in loose]
        if pkgcmd:
            lines.append(f"• remove the {pkgcmd[-1]} package: {shlex.join(pkgcmd)}")
        lines.append("\nLeft in place: Protontricks and any Steam config backups (*.redinstaller-*.bak).")
        check = None
        if os.path.exists(CONFIG_FILE):
            check = Gtk.CheckButton(label=f"Also delete your settings ({CONFIG_FILE})")
        if not loose and not pkgcmd:
            if not check:
                self.alert("Nothing to uninstall", "No installed redinstaller command found.", [("ok", "OK", None)])
                return
            lines.insert(0, "No installed redinstaller command found.")

        def go(r):
            if r != "uninstall":
                return
            done, failed = [], []
            for f in loose:
                if os.access(os.path.dirname(f), os.W_OK):
                    try:
                        os.remove(f)
                        done.append(f"Removed {f}")
                    except OSError as e:
                        failed.append(f"Couldn't remove {f}: {e}")
                elif (cmd := as_root(["rm", "-f", "--", f])) and subprocess.run(cmd).returncode == 0:
                    done.append(f"Removed {f}")
                else:
                    failed.append(f"Couldn't remove {f}; run: sudo rm -f {shlex.quote(f)}")
            if pkgcmd:
                cmd = as_root(pkgcmd)
                if cmd and subprocess.run(cmd).returncode == 0:
                    done.append(f"Removed the {pkgcmd[-1]} package")
                else:
                    failed.append(f"Package removal didn't finish; run: sudo {shlex.join(pkgcmd)}")
            if check and check.get_active():
                try:
                    os.remove(CONFIG_FILE)
                    try:
                        os.rmdir(os.path.dirname(CONFIG_FILE))
                    except OSError:
                        pass
                    done.append("Removed your settings")
                except OSError as e:
                    failed.append(f"Couldn't remove your settings: {e}")
            elif check:
                done.append(f"Kept your settings in {CONFIG_FILE}")
            self.alert("Uninstalled" if not failed else "Uninstall didn't finish", "\n".join(failed + done),
                       [("ok", "Quit", None)], lambda _r: self.get_application().quit())

        self.alert("Uninstall Redinstaller?", "\n".join(lines),
                   [("cancel", "Cancel", None), ("uninstall", "Uninstall", Adw.ResponseAppearance.DESTRUCTIVE)],
                   go, extra=check)


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE)
        GLib.set_application_name("Redinstaller")

    def do_activate(self):
        css = Gtk.CssProvider()
        css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Window(self).present()


if __name__ == "__main__":
    sys.exit(App().run([sys.argv[0]]))
