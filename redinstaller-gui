def bg(func, *args, done=None):
    """Run func(*args) in a thread; call done(result, error) on the main loop."""
    def worker():
        try:
            res, err = func(*args), None
        except Exception as e:  # noqa: BLE001 - shown to the user
            res, err = None, e
        if done:
            GLib.idle_add(lambda: done(res, err) and False)
    threading.Thread(target=worker, daemon=True).start()


