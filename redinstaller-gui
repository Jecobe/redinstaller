class Args:
    def __init__(self, argv):
        self.appid = self.folder = None
        self.no_config = False
        self.overrides = []  # (Options attribute, value), applied in order
        it = iter(argv)
        for a in it:
            o = self.overrides.append
            if a == "--appid":
                self.appid = next(it, None) or sys.exit("--appid needs a value")
            elif a.startswith("--appid="):
                self.appid = a.split("=", 1)[1]
            elif a in ("--recursive", "-r"):
                o(("recursive", True))
            elif a == "--no-recursive":
                o(("recursive", False))
            elif a in ("--silent", "-s"):
                o(("silent", True))
            elif a == "--no-silent":
                o(("silent", False))
            elif a in ("--flatpak", "--native"):
                o(("force", a[2:]))
            elif a in ("--verbose", "-v"):
                o(("verbose", True))
            elif a in ("--dry-run", "-n"):
                o(("dry_run", True))
            elif a in ("--yes", "-y"):
                o(("confirm", False))
            elif a == "--launch-options":
                o(("launch", True))
            elif a.startswith("--launch-options="):
                o(("launch", True))
                o(("launch_value", a.split("=", 1)[1]))
            elif a == "--replace-launch-options":
                o(("launch", True))
                o(("launch_mode", "replace"))
            elif a == "--no-launch-options":
                o(("launch", False))
            elif a == "--no-config":
                self.no_config = True
            elif a in ("-h", "--help"):
                with open(os.path.realpath(__file__)) as fh:
                    for line in fh.read().split("\n")[1:]:
                        if not line.startswith("#"):
                            break
                        print(re.sub(r"^# ?", "", line))
                sys.exit(0)
            elif a in ("-V", "--version"):
                print(f"redinstaller-gui {VERSION}")
                sys.exit(0)
            elif a.startswith("-"):
                sys.exit(f"Unknown option: {a} (see --help)")
            else:
                self.folder = a


