class InstallRunner:
    """Runs the installers one at a time in a thread; reports via callbacks on the main loop."""

    def __init__(self, win, pt, appid, folder, exes, silent, dry, verbose):
        self.win, self.pt, self.appid, self.folder = win, pt, appid, folder
        self.exes, self.silent, self.dry, self.verbose = exes, silent, dry, verbose
        self.proc = None
        self.interrupted = False
        self.answer = threading.Event()
        self.go_on = True
        self.oks, self.fails, self.skips = [], [], []

    def post(self, fn, *a):
        GLib.idle_add(lambda: fn(*a) and False)

    def skip(self):
        """Like Ctrl+C in the terminal: stop the running installer."""
        self.interrupted = True
        proc = self.proc
        if not proc or proc.poll() is not None:
            return
        try:
            os.killpg(proc.pid, signal.SIGINT)
        except OSError:
            return

        def escalate():
            for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 5)):
                time.sleep(wait)
                if proc.poll() is not None:
                    return
                try:
                    os.killpg(proc.pid, sig)
                except OSError:
                    return
        threading.Thread(target=escalate, daemon=True).start()

    def kill(self):
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGKILL)
            except OSError:
                pass

    def start(self):
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        env = dict(os.environ)
        if not self.verbose:
            env.setdefault("WINEDEBUG", "-all")
        total = len(self.exes)
        ui = self.win
        for i, exe in enumerate(self.exes):
            rel = os.path.relpath(exe, self.folder)
            cmd = install_cmd(self.pt, self.appid, exe, self.silent)
            self.post(ui.run_started, i, total, rel, shlex.join(cmd))
            start = time.monotonic()
            rc = 0
            if not self.dry:
                try:
                    self.proc = subprocess.Popen(cmd, cwd=os.path.dirname(exe), stdin=subprocess.DEVNULL,
                                                 stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                                 start_new_session=True, env=env)
                    buf = b""
                    while chunk := self.proc.stdout.read1(4096):
                        buf += chunk.replace(b"\r\n", b"\n").replace(b"\r", b"\n")
                        *lines, buf = buf.split(b"\n")
                        if lines:
                            self.post(ui.run_output, "\n".join(x.decode("utf-8", "replace") for x in lines))
                    if buf:
                        self.post(ui.run_output, buf.decode("utf-8", "replace"))
                    rc = self.proc.wait()
                except OSError:
                    rc = 127
                self.proc = None
            secs = int(time.monotonic() - start)
            if self.interrupted:
                self.interrupted = False
                self.skips.append(rel)
                self.post(ui.run_log, f"⏭ Skipped {rel}", "warn")
                if i + 1 < total:
                    self.answer.clear()
                    self.post(ui.run_ask_continue, self)
                    self.answer.wait()
                    if not self.go_on:
                        self.skips += [os.path.relpath(x, self.folder) for x in self.exes[i + 1:]]
                        break
                continue
            if rc == 0:
                self.oks.append(rel)
                self.post(ui.run_log, f"✔ {rel} ({secs}s)", "ok")
            elif rc == 1638:
                self.oks.append(rel)
                self.post(ui.run_log, f"✔ {rel} (newer version already installed, {secs}s)", "ok")
            elif rc in (3010, 1641):
                self.oks.append(rel)
                self.post(ui.run_log, f"✔ {rel} (reboot requested, ignored, {secs}s)", "ok")
            elif rc == 127:
                self.fails.append(f"{rel} (launcher not found)")
                self.post(ui.run_log, f"✘ {rel}: launcher not found", "err")
            else:
                self.fails.append(f"{rel} (exit {rc})")
                self.post(ui.run_log, f"✘ {rel} (exit {rc}, {secs}s)", "err")
        self.post(ui.run_finished, self)


