def uninstall_plan():
    """(loose files, package command or None)"""
    here = os.path.dirname(os.path.realpath(sys.argv[0]))
    cands = []
    for d in (here, f"{HOME}/.local/bin", "/usr/local/bin", "/usr/bin"):
        cands += [f"{d}/redinstaller", f"{d}/redinstaller-gui"]
    for d in (f"{HOME}/.local/share/applications", "/usr/local/share/applications", "/usr/share/applications"):
        cands.append(f"{d}/{DESKTOP_FILE}")
    files = []
    for f in cands:
        if os.path.isfile(f) and (f := os.path.realpath(f)) not in files:
            files.append(f)
    loose, pkgcmd = [], None

    def owner(cmd):
        try:
            r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return None
        return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else None

    for f in files:
        if shutil.which("pacman") and (o := owner(["pacman", "-Qqo", f])):
            pkgcmd = ["pacman", "-R", "--noconfirm", o]
        elif shutil.which("dpkg") and (o := owner(["dpkg", "-S", f])):
            pkgcmd = ["apt", "remove", "-y", o.split(":")[0]]
        elif shutil.which("rpm") and (o := owner(["rpm", "-qf", "--qf", "%{NAME}", f])):
            pkgcmd = ["dnf", "remove", "-y", o]
        else:
            loose.append(f)
    return loose, pkgcmd


def as_root(cmd):
    if os.geteuid() == 0:
        return cmd
    return ["pkexec"] + cmd if shutil.which("pkexec") else None


